{
    "$schema": "./zowe.schema.json",
  
    "profiles": {
         
        
        "rse": {
            "type": "rse",
            "COMMENT0": "For zOSMF, change the above type and profile name to zosmf. And add an ssh profile and conf local keys.",
            "properties": {
                "port": 8195                
            }
        },
        "zOpenDebug": {
            "type": "zOpenDebug",
            "properties": {
                "COMMENT2": "DPS (Profile service) port connect to the EQAPROF STC for debug and TAZ/EDT",
                "dpsPort": 8192,
                "dpsContextRoot": "api/v1",
                "dpsSecured": false,
                
                "COMMENT3": "RDS (Remote Client service) port connect to the EQARMTD STC. See eqahcc.env for CC port accessed by RDS ",                
                "rdsPort": 8193,
                "rdsSecured": false,
                "authenticationType": "basic",
                "uuid": "1959edc3-5bcf-4912-8569-0a115f0a2f38",

            }
        },
        "project_base": {
            "type": "base",
            "properties": {
                "protocol": "https",
                "rejectUnauthorized": false,
                "basePath": "rseapi",
                "COMMENT4": "Using TZ-Preview PubIP",       
                "host": "52.118.188.193"
            },
            "secure": [
                "user",
                "password"
            ]
        }
    },
    "autoStore": true,
    "defaults": {
        "base": "project_base",
        "rse": "rse",
        "zOpenDebug": "zOpenDebug"
    }
}
