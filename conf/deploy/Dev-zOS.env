---
# A sample Wazi Deploy (WD) environment descriptor file v17 (Feb-12  2026)  V2 App Override Beta
# This files defines a target zOS host's environment setting for DB2 CICS and Batch deployment and target PDSs ..
#  
# Building blocks supported by this config: 
#   https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=blocks-member-copy
#   https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=blocks-db2-bind-package
#   https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=blocks-cics-cmci-prog-update

apiVersion: deploy.ibm.com/v1
kind:       Environment

metadata:
  name:     "Dev1"
  version:  1.0.0
  description: "A sample environment definition file for a Dev Sandbox. Change the various setting to match your target z Host"


# Hardcode certain system vars 
default_cics_cmci_action: "NEWCOPY" 
default_cmci_url:         "https://localhost:8154"
default_cics_context:     "CICSTS63"

default_subsys:           "DBD1"
default_db2_sdsnload:     "DB2V13.SDSNLOAD"
default_uss_root:         ""

jobcard:                  "IBMUSERK JOB WD-PKGBIND,MSGLEVEL=(1,1),MSGCLASS=A"

# For demo purpose hard code app vars 
# see my ivp script for pass app arg in -e cli while uplife is read for GA
app_user:         "IBMUSER"
app_hlq:          "ZDEV.WD17"
app_cmci_tok:     "jeep0924"

app_db2_plan:     "DATPLAN"
app_db2_collid:   "DAT"

# job_submit template vars 
# ref:  https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=translators-variables-in-jinja2-templates
template_values:  
  jobcard: "IBMUSERK JOB WD-PKGBIND,MSGLEVEL=(1,1),MSGCLASS=A"
  cicscontext: "CICSTS63" 

# the spec section defines section subsection like CICS and DB2 vars passed within the types: section to a building-block process
spec:
  # Common app vars 
  hlq:        "{{ app_hlq  }}"  

  # Var from -e cli and defaults 
  cics_sys_def:    
    context:        "{{ default_cics_context }}"
    cmci_url:       "{{ default_cmci_url }}"
    insecure: True 

    cmci_user:      "{{ app_user }}" 
    cmci_password:  "{{ app_cmci_tok }}"
    csd_group:      ""


  db2_sys_def:       
    subsys:   "{{ default_subsys }}"
    sdsnload: "{{ default_db2_sdsnload }}"
    package_action:     "REPLACE"   
    package_maxrc:      4     
    plan_action:        "REPLACE"     
    plan_maxrc:         4

    
    # App Bind-Package for deployType dbrm      
    user:       "{{ app_user }}"  
    package_jobcard:    "{{ jobcard }}"
    package:            "PACKAGENAME"
    qualifier:          "{{ app_user }}"     
    

    # App Bind-Plan  for deployType dbrmp
    plan_jobcard:       "{{ jobcard }}"
    plan:               "{{ app_db2_plan}}"
    plan_pklist:        "*.{{ app_db2_collid }}.*"



  # Dataset allocations - These datasets are normally pre-allocated.  
  common_pds_load_spec:
      type:             LIBRARY
      primary_space:    10CYL
      secondary_space:  20CYL
      record_format:    U
      record_length:    0

  common_pds_binary_spec:
      type: LIBRARY
      primary_space:    10CYL
      secondary_space:  20CYL
      record_format:    FB
      record_length:    80



# -------------  
# This section maps an artifacts DeployType to a target Dataset in the host 
# Ref: https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=translators-generic-environment-variables-ansible-python-building-blocks
types:
  - pattern:        .*\.LOAD$
    dataset:        "{{ spec.hlq  }}.LOAD"
    dataset_backup: "{{ spec.hlq  }}.BACK.LOAD"
    spec:           "{{ spec.common_pds_load_spec }}"
    is_load:        True
    force_lock:     True
    aliases:        True

  - pattern:        .*\.CICSLOAD$
    dataset:        "{{ spec.hlq  }}.LOADLIB"
    dataset_backup: "{{ spec.hlq  }}.BACK.LOADLIB"
    spec:           "{{ spec.common_pds_load_spec }}"
    is_load:        True
    force_lock:     True
    aliases:        True
    cics_systems:   
      - "{{ spec.cics_sys_def }}"

  - pattern:        .*\.MAPLOAD$
    dataset:        "{{ spec.hlq  }}.LOADLIB"
    dataset_backup: "{{ spec.hlq  }}.BACK.LOADLIB"
    spec:           "{{ spec.common_pds_load_spec }}"
    is_load:        True
    force_lock:     True
    aliases:        True
    cics_systems:   
      - "{{ spec.cics_sys_def }}"
  
  - pattern:        .*.DBRM$
    dataset:        "{{ spec.hlq  }}.DBRM"
    dataset_backup: "{{ spec.hlq  }}.BACK.DBRM"
    spec:           "{{ spec.common_pds_binary_spec }}"
    is_binary:      True
    force_lock:     True
    db2_systems:    
      - "{{ spec.db2_sys_def }}"
  
    
  - pattern:        .*.DBRMP$
    dataset:        "{{ spec.hlq  }}.DBRMP"
    dataset_backup: "{{ spec.hlq  }}.BACK.DBRMP"
    spec:           "{{ spec.common_pds_binary_spec }}"
    is_binary:      True
    force_lock:     True
    db2_systems:    
      - "{{ spec.db2_sys_def }}"



# -------------  
# Demo oper cmd see deploy method - test with IVP
# -------------  
ocmd: 
  cmd: "D SYMBOLS"
  case_sensitive: false 


# -------------  
# Submit a job 
# ref: https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=blocks-job-submit
# -------------  
my_var_job_submit:
  # src:
  # Required
  # The full or relative path to the file that contains the JCL to submit. This file, which is in the z/OS environment, can be a file or a Jinja2 template.
  # https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=translators-variables-in-jinja2-templates
  src:   /u/ibmuser/zdevops/conf/deploy/jinja2/sample.jcl.j2
  
  # search_paths:
  # List
  # The variable that indicates the list of paths where included Jinja2 templates are stored.
  # It is used when use_template is set to True.
  # TODO: create a new etc/profile var call DEPLOY_HOME=$adminRepo/conf/deploy.  And test below. hard code for now
  search_paths: 
    - /u/ibmuser/zdevops/conf/deploy/jinja2


  # dest:
  # Path
  # The full or relative path to the target file to be created in the z/OS environment.
  # This target file contains the jinja2 template rendered. This variable is required if use_template is set to True.
  dest: "tmp/ivp/sample.jcl"

  
  max_rc: 12
  use_template: True
  wait_time_s: 25
