---
# A sample Wazi Deploy (WD) environment descriptor file v17 (Feb-12  2026)  V3 non-cmci
# This files defines a target zOS host's environment settings for DB2 CICS and Batch deployments 
# See the related deplyment_method used to generate a plan that asscoated to the ENV file 

apiVersion: deploy.ibm.com/v1
kind:       Environment

metadata:
  name:     "Dev1"
  version:  1.0.0
  description: "A sample environment definition file for a Dev Sandbox. Change the various setting to match your target z Host"


# Hardcode certain system vars 
default_cics_action:      "NEWCOPY" 
default_cics_context:     "CICSTS63"

default_subsys:           "DBD1"
default_db2_sdsnload:     "DB2V13.SDSNLOAD"
default_uss_root:         ""

jobcard:                  "IBMUSERK JOB WD-PKGBIND,MSGLEVEL=(1,1),MSGCLASS=A"

# --- 
# App vars for demo purposes 
# Change the value for support a bind for your app 
# Values can be passed via the cli using '-e' option
app_user:         "IBMUSER"
app_hlq:          "ZDEV.WD17"
app_db2_plan:     "DATPLAN"
app_db2_collid:   "DAT"


# -------------  
# job_submit template vars 
#   Generate and submit a newcopy job for all CICS packaged artifacts
#   See the deployment method used to generate a plan for this Env file# 
#   ref: 
#    https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=blocks-job-submit
#    https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=translators-variables-in-jinja2-templates
# -------------  
template_values:  
  jobcard: "IBMUSERC JOB WD-CICSNEWC,MSGLEVEL=(1,1),MSGCLASS=A"
  context: "CICSTS63" 

newcopy_job:
  # The  path to the jinja2 JCL template   (TODO: Need a new env vars to avoid hard coding here) 
  src:   /u/ibmuser/zdevops/conf/deploy/jinja2/newcopy.jcl.j2
  
  # The output path for the generated JCL. Relative to the workingFolder.
  # The filename is set to the artifact file name set durung the generate phase and 
  # passed to the deply phase via the generate deployment plan.   
  dest: "tmp/ivp/cics_newcopy_modify_jobs/{{ cicsload }}.jcl"
  
  max_rc: 12
  use_template: True
  wait_time_s: 25


# the spec section defines vars for DB2  and target PDS HLQ
spec:
  # Common app vars 
  hlq:        "{{ app_hlq  }}"  
  
  
  db2_sys_def:       
    subsys:   "{{ default_subsys }}"
    sdsnload: "{{ default_db2_sdsnload }}"
    package_action:     "REPLACE"   
    package_maxrc:      4     
    plan_action:        "REPLACE"     
    plan_maxrc:         4

    
    # App Bind-Package for deployType dbrm      
    user:       "{{ app_user }}"  
    package_jobcard:    "{{ jobcard }}"
    package:            "PACKAGENAME"
    qualifier:          "{{ app_user }}"     
    

    # App Bind-Plan  for deployType dbrmp
    plan_jobcard:       "{{ jobcard }}"
    plan:               "{{ app_db2_plan}}"
    plan_pklist:        "*.{{ app_db2_collid }}.*"



  # Dataset allocations - These datasets are normally pre-allocated.  
  common_pds_load_spec:
      type:             LIBRARY
      primary_space:    10CYL
      secondary_space:  20CYL
      record_format:    U
      record_length:    0

  common_pds_binary_spec:
      type: LIBRARY
      primary_space:    10CYL
      secondary_space:  20CYL
      record_format:    FB
      record_length:    80



# -------------  
# This section maps an artifacts DeployType to a target Dataset in the host 
# Ref: https://www.ibm.com/docs/en/developer-for-zos/17.0.x?topic=translators-generic-environment-variables-ansible-python-building-blocks
types:
  - pattern:        .*\.LOAD$
    dataset:        "{{ spec.hlq  }}.LOAD"
    dataset_backup: "{{ spec.hlq  }}.BACK.LOAD"
    spec:           "{{ spec.common_pds_load_spec }}"
    is_load:        True
    force_lock:     True
    aliases:        True

  - pattern:        .*\.CICSLOAD$
    dataset:        "{{ spec.hlq  }}.LOADLIB"
    dataset_backup: "{{ spec.hlq  }}.BACK.LOADLIB"
    spec:           "{{ spec.common_pds_load_spec }}"
    is_load:        True
    force_lock:     True
    aliases:        True
  
  - pattern:        .*\.MAPLOAD$
    dataset:        "{{ spec.hlq  }}.LOADLIB"
    dataset_backup: "{{ spec.hlq  }}.BACK.LOADLIB"
    spec:           "{{ spec.common_pds_load_spec }}"
    is_load:        True
    force_lock:     True
    aliases:        True
    
  - pattern:        .*.DBRM$
    dataset:        "{{ spec.hlq  }}.DBRM"
    dataset_backup: "{{ spec.hlq  }}.BACK.DBRM"
    spec:           "{{ spec.common_pds_binary_spec }}"
    is_binary:      True
    force_lock:     True
    db2_systems:    
      - "{{ spec.db2_sys_def }}"
  
    
  - pattern:        .*.DBRMP$
    dataset:        "{{ spec.hlq  }}.DBRMP"
    dataset_backup: "{{ spec.hlq  }}.BACK.DBRMP"
    spec:           "{{ spec.common_pds_binary_spec }}"
    is_binary:      True
    force_lock:     True
    db2_systems:    
      - "{{ spec.db2_sys_def }}"
